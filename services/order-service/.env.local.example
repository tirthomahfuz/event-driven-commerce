# Template for local-only Postgres credentials used by docker-compose.yml.
#
#   cp .env.local.example .env.local
#
# .env.local is git-ignored and must NEVER be committed.
# These values are for LOCAL DEVELOPMENT ONLY. In real environments these are
# injected from AWS Secrets Manager; the app only ever reads DATABASE_URL, so
# the source of the value can change without touching app code.

# Used by the postgres container to initialize the database/user on first boot.
POSTGRES_USER=orders
POSTGRES_PASSWORD=orders_local_dev_pw
POSTGRES_DB=orders

# Env var contract shared with the infra agent: the FastAPI service reads
# DATABASE_URL for its Postgres connection. host=localhost because the app and
# Alembic run on the host and reach Postgres through the published port.
DATABASE_URL=postgresql://orders:orders_local_dev_pw@localhost:5432/orders
